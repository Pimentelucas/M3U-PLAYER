<Window x:Class="M3UPlayer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
        xmlns:local="clr-namespace:M3UPlayer"
        Title="M3U Player" Height="820" Width="1380" MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen" AllowDrop="True"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI" FontSize="13"
        Loaded="Window_Loaded" Closing="Window_Closing" Drop="Window_Drop"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <local:LogoConverter x:Key="LogoConverter" />
        <local:BoolToVisibilityConverter x:Key="BoolToVis" />

        <!-- Seta do carrossel (sobre a ponta da linha de cards) -->
        <Style x:Key="RowArrow" TargetType="Button">
            <Setter Property="Width" Value="52" />
            <Setter Property="Margin" Value="0,8,0,48" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
            <Setter Property="FontSize" Value="22" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="12" Background="#B3000000">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Botão sem aparência própria (fundo da prévia e o card grande) -->
        <Style x:Key="BareButton" TargetType="Button">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ───── Card (pôster 2:3 para filmes/séries, quadrado para canais) ───── -->
        <DataTemplate x:Key="CardTemplate">
            <Button x:Name="CardBtn" Style="{StaticResource CardButton}" Click="Card_Click" Width="185"
                    Margin="0,8,18,10">
                <Button.ContextMenu>
                    <ContextMenu Opened="CardMenu_Opened">
                        <MenuItem Tag="play" Header="Reproduzir" Click="CardMenu_Click" />
                        <MenuItem Tag="restart" Header="Assistir do início" Click="CardMenu_Click" />
                        <MenuItem Tag="download" Header="Baixar" Click="CardMenu_Click" />
                        <MenuItem Tag="copy" Header="Copiar URL" Click="CardMenu_Click" />
                        <Separator />
                        <MenuItem Tag="forget" Header="Remover de &quot;Continuar assistindo&quot;" Click="CardMenu_Click" />
                    </ContextMenu>
                </Button.ContextMenu>
                <StackPanel>
                    <Grid x:Name="Poster" Height="278" RenderTransformOrigin="0.5,0.5">
                        <Border x:Name="Frame" CornerRadius="12" Background="{StaticResource Surface2Brush}"
                                BorderThickness="2" BorderBrush="Transparent" />
                        <TextBlock Text="{Binding Initials}" FontSize="38" FontWeight="Bold" Foreground="{StaticResource MutedBrush}"
                                   Opacity="0.4" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <Border x:Name="ArtFill" CornerRadius="10" Margin="2" local:Art.Width="370" />
                        <Border x:Name="ArtFit" Margin="26" Visibility="Collapsed" local:Art.Width="260" local:Art.Fit="True" />
                        <ProgressBar Style="{StaticResource ThinProgress}" VerticalAlignment="Bottom" Margin="12,0,12,12"
                                     Maximum="1" Value="{Binding Progress, Mode=OneWay}" Background="#99000000"
                                     Visibility="{Binding HasProgress, Converter={StaticResource BoolToVis}}" />
                        <Border Width="24" Height="24" CornerRadius="12" Background="{StaticResource AccentBrush}"
                                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="10"
                                Visibility="{Binding Watched, Converter={StaticResource BoolToVis}}" ToolTip="Assistido">
                            <TextBlock Text="&#xE73E;" FontFamily="{StaticResource IconFont}" FontSize="11"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </Grid>
                    <!-- Minimalista: só o título (e o episódio, quando é um episódio) -->
                    <TextBlock Text="{Binding Title}" Margin="2,10,2,0" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="CardSub" Text="{Binding CardSubtitle}" Margin="2,2,2,0" FontSize="11"
                               Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Button>
            <DataTemplate.Triggers>
                <!-- Só o Border visível carrega a imagem -->
                <DataTrigger Binding="{Binding IsSquare}" Value="False">
                    <Setter TargetName="ArtFill" Property="local:Art.Url" Value="{Binding Logo}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSquare}" Value="True">
                    <Setter TargetName="Poster" Property="Height" Value="185" />
                    <Setter TargetName="ArtFill" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="ArtFit" Property="Visibility" Value="Visible" />
                    <Setter TargetName="ArtFit" Property="local:Art.Url" Value="{Binding Logo}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding CardSubtitle}" Value="">
                    <Setter TargetName="CardSub" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <Trigger SourceName="CardBtn" Property="IsMouseOver" Value="True">
                    <Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                    <Setter TargetName="Poster" Property="RenderTransform">
                        <Setter.Value>
                            <ScaleTransform ScaleX="1.03" ScaleY="1.03" />
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- ───── Linha da página inicial ───── -->
        <DataTemplate x:Key="RowTemplate">
            <StackPanel Margin="0,0,0,22">
                <DockPanel Margin="0,0,16,4">
                    <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Click="SeeAll_Click"
                            Foreground="{StaticResource MutedBrush}"
                            Visibility="{Binding ShowSeeAll, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Ver tudo" />
                            <TextBlock Text="&#xE76C;" FontFamily="{StaticResource IconFont}" FontSize="10" Margin="8,2,0,0" />
                        </StackPanel>
                    </Button>
                    <TextBlock Text="{Binding Title}" FontSize="19" FontWeight="Bold" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                </DockPanel>
                <!-- Carrossel: setas nas pontas passam para os próximos/anteriores títulos da categoria -->
                <Grid>
                    <ItemsControl ItemsSource="{Binding Items}" ItemTemplate="{StaticResource CardTemplate}" ClipToBounds="True">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                    <Button Style="{StaticResource RowArrow}" HorizontalAlignment="Left" Content="&#xE76B;" ToolTip="Anteriores"
                            Click="RowBack_Click" Visibility="{Binding CanBack, Converter={StaticResource BoolToVis}}" />
                    <Button Style="{StaticResource RowArrow}" HorizontalAlignment="Right" Content="&#xE76C;" ToolTip="Mais títulos"
                            Click="RowForward_Click" Visibility="{Binding CanForward, Converter={StaticResource BoolToVis}}" />
                </Grid>
            </StackPanel>
        </DataTemplate>

        <!-- ───── Linha da grade (vários cards lado a lado) ───── -->
        <DataTemplate x:Key="GridRowTemplate">
            <ItemsControl ItemsSource="{Binding Items}" ItemTemplate="{StaticResource CardTemplate}" Margin="0,0,0,10">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </DataTemplate>

        <!-- Lista vertical virtualizada (linhas da home e da grade) -->
        <ControlTemplate x:Key="VirtualListTemplate" TargetType="ItemsControl">
            <ScrollViewer CanContentScroll="True" Focusable="False" HorizontalScrollBarVisibility="Disabled"
                          PreviewMouseWheel="FastScroll_PreviewMouseWheel">
                <ItemsPresenter Margin="32,4,16,24" />
            </ScrollViewer>
        </ControlTemplate>

        <!-- ───── Episódio ───── -->
        <DataTemplate x:Key="EpisodeTemplate">
            <Button Style="{StaticResource RowButton}" Click="Episode_Click" Margin="0,0,0,4">
                <Button.ContextMenu>
                    <ContextMenu Opened="CardMenu_Opened">
                        <MenuItem Tag="play" Header="Reproduzir" Click="CardMenu_Click" />
                        <MenuItem Tag="restart" Header="Assistir do início" Click="CardMenu_Click" />
                        <MenuItem Tag="download" Header="Baixar" Click="CardMenu_Click" />
                        <MenuItem Tag="copy" Header="Copiar URL" Click="CardMenu_Click" />
                        <Separator />
                        <MenuItem Tag="forget" Header="Marcar como não assistido" Click="CardMenu_Click" />
                    </ContextMenu>
                </Button.ContextMenu>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="160" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid Height="90">
                        <Border CornerRadius="8" Background="{StaticResource Surface2Brush}" />
                        <Border CornerRadius="8" local:Art.Width="320" local:Art.Url="{Binding Logo}" />
                        <ProgressBar Style="{StaticResource ThinProgress}" VerticalAlignment="Bottom" Margin="8,0,8,8"
                                     Maximum="1" Value="{Binding Progress, Mode=OneWay}" Background="#99000000"
                                     Visibility="{Binding HasProgress, Converter={StaticResource BoolToVis}}" />
                    </Grid>
                    <StackPanel Grid.Column="1" Margin="16,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding EpisodeHeading}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding EpisodeCode}" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="&#xE73E;" FontFamily="{StaticResource IconFont}" Foreground="{StaticResource AccentBrush}"
                                   FontSize="16" VerticalAlignment="Center" Margin="0,0,12,0" ToolTip="Assistido"
                                   Visibility="{Binding Watched, Converter={StaticResource BoolToVis}}" />
                        <Button Style="{StaticResource IconButton}" Content="&#xE896;" ToolTip="Baixar episódio"
                                Click="EpisodeDownload_Click" />
                    </StackPanel>
                </Grid>
            </Button>
        </DataTemplate>

        <!-- ───── Download: uma linha (um arquivo) ───── -->
        <DataTemplate x:Key="DownloadTemplate">
            <Grid Margin="0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Text="{Binding StateText}" Foreground="{StaticResource MutedBrush}"
                                   Margin="12,0,0,0" />
                        <TextBlock x:Name="RowTitle" Text="{Binding RowTitle}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    </DockPanel>
                    <ProgressBar Style="{StaticResource ThinProgress}" Height="5" Margin="0,7" Maximum="100"
                                 Value="{Binding Progress, Mode=OneWay}" IsIndeterminate="{Binding IsIndeterminate, Mode=OneWay}" />
                    <TextBlock Text="{Binding Detail}" Foreground="{StaticResource MutedBrush}" FontSize="12"
                               TextTrimming="CharacterEllipsis" ToolTip="{Binding Detail}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <Button Content="Parar" Click="CancelDownload_Click" Margin="4,0,0,0"
                            Visibility="{Binding IsActive, Converter={StaticResource BoolToVis}}" />
                    <Button Content="Abrir" Click="OpenDownload_Click" Margin="4,0,0,0" Style="{StaticResource AccentButton}"
                            Visibility="{Binding IsCompleted, Converter={StaticResource BoolToVis}}" />
                    <Button Style="{StaticResource IconButton}" Content="&#xE8B7;" Click="RevealDownload_Click" Margin="4,0,0,0"
                            ToolTip="Mostrar na pasta" Width="34" Height="34"
                            Visibility="{Binding IsCompleted, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding RowTitle}" Value="">
                    <Setter TargetName="RowTitle" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- ───── Download: grupo (um filme/canal, ou todos os episódios de uma série) com a imagem ───── -->
        <DataTemplate x:Key="DownloadGroupTemplate">
            <Border Background="{StaticResource SurfaceBrush}" CornerRadius="14" Padding="16" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="96" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid x:Name="Thumb" Height="144" VerticalAlignment="Top">
                        <Border CornerRadius="10" Background="{StaticResource Surface2Brush}" />
                        <TextBlock Text="{Binding Initials}" FontSize="26" FontWeight="Bold" Opacity="0.4"
                                   Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <Border x:Name="ThumbFill" CornerRadius="10" local:Art.Width="200" local:Art.Url="{Binding Logo}" />
                        <Border x:Name="ThumbFit" Margin="12" Visibility="Collapsed" local:Art.Width="160" local:Art.Fit="True"
                                local:Art.Url="{Binding Logo}" />
                    </Grid>
                    <StackPanel Grid.Column="1" Margin="18,0,0,0">
                        <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Summary}" Foreground="{StaticResource MutedBrush}" Margin="0,2,0,6" />
                        <ItemsControl ItemsSource="{Binding Items}" ItemTemplate="{StaticResource DownloadTemplate}" />
                    </StackPanel>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsSquare}" Value="True">
                    <Setter TargetName="Thumb" Property="Height" Value="96" />
                    <Setter TargetName="ThumbFill" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="ThumbFit" Property="Visibility" Value="Visible" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <!-- ═════════════ Biblioteca (topo + páginas) ═════════════ -->
        <DockPanel x:Name="Shell">
            <Border DockPanel.Dock="Top" Padding="24,14" Background="{StaticResource BgBrush}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,24,0">
                        <Border Width="30" Height="30" CornerRadius="8" Background="{StaticResource AccentBrush}">
                            <TextBlock Text="&#xE768;" FontFamily="{StaticResource IconFont}" FontSize="13"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" Margin="2,0,0,0" />
                        </Border>
                        <TextBlock Text="M3U Player" FontSize="17" FontWeight="Bold" Margin="10,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <RadioButton x:Name="TabHome" Style="{StaticResource NavTab}" GroupName="Nav" Content="Início"
                                     IsChecked="True" Checked="Tab_Checked" />
                        <RadioButton x:Name="TabLive" Style="{StaticResource NavTab}" GroupName="Nav" Content="TV ao vivo"
                                     Checked="Tab_Checked" />
                        <RadioButton x:Name="TabMovies" Style="{StaticResource NavTab}" GroupName="Nav" Content="Filmes"
                                     Checked="Tab_Checked" />
                        <RadioButton x:Name="TabSeries" Style="{StaticResource NavTab}" GroupName="Nav" Content="Séries"
                                     Checked="Tab_Checked" />
                        <RadioButton x:Name="TabDownloads" Style="{StaticResource NavTab}" GroupName="Nav" Checked="Tab_Checked">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Downloads" />
                                <Border x:Name="DownloadBadge" Background="{StaticResource AccentBrush}" CornerRadius="9"
                                        MinWidth="18" Height="18" Padding="5,0" Margin="8,0,0,0" Visibility="Collapsed">
                                    <TextBlock x:Name="DownloadBadgeText" FontSize="11" Foreground="White"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>

                    <TextBox x:Name="SearchBox" Grid.Column="2" Style="{StaticResource SearchBox}" Tag="Buscar filmes, séries e canais"
                             MaxWidth="440" Margin="24,0" TextChanged="SearchBox_TextChanged" />

                    <Button x:Name="ListsButton" Grid.Column="3" Click="ListsButton_Click" ToolTip="Listas M3U e configurações">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8FD;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" />
                            <TextBlock Text="Listas" Margin="8,0,0,0" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <Grid>
                <!-- Página: biblioteca -->
                <Grid x:Name="LibraryPage">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Categorias (grupos da aba) na lateral esquerda -->
                    <DockPanel x:Name="SidePanel" Grid.RowSpan="3" Width="250" Margin="24,4,0,16" Visibility="Collapsed">
                        <TextBlock DockPanel.Dock="Top" Text="CATEGORIAS" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{StaticResource MutedBrush}" Margin="14,4,0,10" />
                        <ListBox x:Name="ChipList" Style="{StaticResource SideList}"
                                 SelectionChanged="ChipList_SelectionChanged" />
                    </DockPanel>

                    <StackPanel x:Name="GridHeader" Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="20,0,32,4" Visibility="Collapsed">
                        <Button Style="{StaticResource IconButton}" Content="&#xE72B;" ToolTip="Voltar" Click="GridBack_Click"
                                Margin="0,0,6,0" />
                        <TextBlock x:Name="GridTitle" FontSize="22" FontWeight="Bold" VerticalAlignment="Center" />
                        <TextBlock x:Name="GridCount" Foreground="{StaticResource MutedBrush}" Margin="12,4,0,0"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <ItemsControl x:Name="HomeList" Grid.Row="2" Grid.Column="1" Template="{StaticResource VirtualListTemplate}"
                                  ItemTemplate="{StaticResource RowTemplate}" SizeChanged="HomeList_SizeChanged"
                                  VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                                  VirtualizingPanel.ScrollUnit="Pixel">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>

                    <ItemsControl x:Name="GridList" Grid.Row="2" Grid.Column="1" Template="{StaticResource VirtualListTemplate}"
                                  ItemTemplate="{StaticResource GridRowTemplate}" Visibility="Collapsed"
                                  VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                                  VirtualizingPanel.ScrollUnit="Pixel" SizeChanged="GridList_SizeChanged">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>

                    <!-- Mensagens: carregando / vazio -->
                    <StackPanel x:Name="MessagePanel" Grid.Row="2" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                                MaxWidth="460" Visibility="Collapsed">
                        <TextBlock x:Name="MessageIcon" FontFamily="{StaticResource IconFont}" FontSize="40"
                                   HorizontalAlignment="Center" Foreground="{StaticResource MutedBrush}" />
                        <TextBlock x:Name="MessageTitle" FontSize="20" FontWeight="Bold" Margin="0,16,0,0"
                                   HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
                        <TextBlock x:Name="MessageText" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,0"
                                   HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
                        <ProgressBar x:Name="MessageProgress" Style="{StaticResource ThinProgress}" IsIndeterminate="True"
                                     Width="260" Margin="0,18,0,0" Visibility="Collapsed" />
                        <Button x:Name="MessageButton" Style="{StaticResource AccentButton}" Content="Adicionar lista"
                                HorizontalAlignment="Center" Margin="0,18,0,0" Click="ListsButton_Click" Visibility="Collapsed" />
                    </StackPanel>
                </Grid>

                <!-- Página: detalhes da série -->
                <Grid x:Name="SeriesPage" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Margin="32,8,32,24" Width="240">
                        <Button Style="{StaticResource GhostButton}" HorizontalAlignment="Left" Click="SeriesBack_Click"
                                Margin="-12,0,0,16">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE72B;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" />
                                <TextBlock Text="Voltar" Margin="10,0,0,0" />
                            </StackPanel>
                        </Button>
                        <Grid Height="360">
                            <Border CornerRadius="12" Background="{StaticResource Surface2Brush}" />
                            <TextBlock x:Name="SeriesInitials" FontSize="48" FontWeight="Bold" Opacity="0.45"
                                       Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Border x:Name="SeriesPoster" CornerRadius="12" local:Art.Width="400" />
                        </Grid>
                    </StackPanel>

                    <Grid Grid.Column="1" Margin="0,60,32,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock x:Name="SeriesTitle" FontSize="30" FontWeight="Bold" TextWrapping="Wrap" />
                        <TextBlock x:Name="SeriesInfoText" Grid.Row="1" Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0" />
                        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,18,0,18">
                            <Button x:Name="SeriesPlayButton" Style="{StaticResource AccentButton}" Padding="20,10" Click="SeriesPlay_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE768;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" />
                                    <TextBlock x:Name="SeriesPlayText" Margin="10,0,0,0" />
                                </StackPanel>
                            </Button>
                            <Button Margin="10,0,0,0" Padding="16,10" Click="SeriesDownloadSeason_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE896;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" />
                                    <TextBlock Text="Baixar temporada" Margin="10,0,0,0" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <DockPanel Grid.Row="3">
                            <ListBox x:Name="SeasonList" DockPanel.Dock="Top" Style="{StaticResource ChipList}" Margin="0,0,0,12"
                                     SelectionChanged="SeasonList_SelectionChanged" PreviewMouseWheel="ChipList_PreviewMouseWheel" />
                            <ItemsControl x:Name="EpisodeList" ItemTemplate="{StaticResource EpisodeTemplate}"
                                          VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.ScrollUnit="Pixel">
                                <ItemsControl.Template>
                                    <ControlTemplate TargetType="ItemsControl">
                                        <ScrollViewer CanContentScroll="True" Focusable="False" HorizontalScrollBarVisibility="Disabled">
                                            <ItemsPresenter Margin="0,0,8,24" />
                                        </ScrollViewer>
                                    </ControlTemplate>
                                </ItemsControl.Template>
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <VirtualizingStackPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </DockPanel>
                    </Grid>
                </Grid>

                <!-- Página: downloads -->
                <Grid x:Name="DownloadsPage" Visibility="Collapsed" Margin="32,8,32,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,16">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                            <Button Content="Abrir pasta" Click="OpenFolder_Click" />
                            <Button Content="Limpar falhas" ToolTip="Tira da lista os downloads que falharam ou foram cancelados" Click="ClearFinished_Click" Margin="8,0,0,0" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Downloads" FontSize="22" FontWeight="Bold" />
                            <!-- Pastas de destino (filmes/canais e séries), cada uma com "Alterar pasta" -->
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition />
                                    <RowDefinition />
                                </Grid.RowDefinitions>
                                <TextBlock Text="Filmes e canais" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,14,0" />
                                <TextBlock x:Name="DownloadFolderText" Grid.Column="1" Foreground="{StaticResource MutedBrush}"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                <Button Grid.Column="2" Style="{StaticResource GhostButton}" Content="Alterar pasta" Tag="movies"
                                        Click="ChooseFolder_Click" Margin="10,2,0,2" />
                                <TextBlock Grid.Row="1" Text="Séries" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,14,0" />
                                <TextBlock x:Name="DownloadSeriesFolderText" Grid.Row="1" Grid.Column="1" Foreground="{StaticResource MutedBrush}"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                <Button Grid.Row="1" Grid.Column="2" Style="{StaticResource GhostButton}" Content="Alterar pasta" Tag="series"
                                        Click="ChooseFolder_Click" Margin="10,2,0,2" />
                            </Grid>
                        </StackPanel>
                    </DockPanel>
                    <ItemsControl x:Name="DownloadList" Grid.Row="1" ItemTemplate="{StaticResource DownloadGroupTemplate}">
                        <ItemsControl.Template>
                            <ControlTemplate TargetType="ItemsControl">
                                <ScrollViewer Focusable="False" HorizontalScrollBarVisibility="Disabled">
                                    <ItemsPresenter Margin="0,0,8,24" />
                                </ScrollViewer>
                            </ControlTemplate>
                        </ItemsControl.Template>
                    </ItemsControl>
                    <StackPanel x:Name="DownloadsEmpty" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="&#xE896;" FontFamily="{StaticResource IconFont}" FontSize="40" HorizontalAlignment="Center"
                                   Foreground="{StaticResource MutedBrush}" />
                        <TextBlock Text="Nenhum download ainda" FontSize="20" FontWeight="Bold" Margin="0,16,0,0" HorizontalAlignment="Center" />
                        <TextBlock Text="Clique num filme, episódio ou canal e use o botão de download (ou o botão direito → &quot;Baixar&quot;)."
                                   Foreground="{StaticResource MutedBrush}" Margin="0,8,0,0" HorizontalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Grid>
        </DockPanel>

        <!-- ═════════════ Player (tela cheia dentro da janela) ═════════════ -->
        <Grid x:Name="PlayerPage" Background="Black" Visibility="Collapsed">
            <vlc:VideoView x:Name="VideoView">
                <!-- Esta camada fica numa janela transparente sobre o vídeo (limitação do HWND do VLC). -->
                <Grid x:Name="Overlay" Background="#01000000" Focusable="True"
                      MouseMove="Overlay_MouseMove" MouseLeftButtonDown="Overlay_MouseLeftButtonDown"
                      PreviewKeyDown="Window_PreviewKeyDown">
                    <Grid x:Name="Chrome">
                        <Border VerticalAlignment="Top" Height="110" IsHitTestVisible="False">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#CC000000" Offset="0" />
                                    <GradientStop Color="#00000000" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <Border VerticalAlignment="Bottom" Height="170" IsHitTestVisible="False">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#00000000" Offset="0" />
                                    <GradientStop Color="#E6000000" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>

                        <!-- Topo: voltar + título -->
                        <DockPanel x:Name="TopControls" VerticalAlignment="Top" Margin="16,14,16,0">
                            <Button Style="{StaticResource IconButton}" Content="&#xE72B;" ToolTip="Voltar (Esc)"
                                    Click="PlayerBack_Click" Foreground="White" />
                            <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock x:Name="PlayerTitle" FontSize="18" FontWeight="SemiBold" Foreground="White"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="PlayerSubtitle" Foreground="#CCFFFFFF" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </DockPanel>

                        <!-- Base: tempo + controles -->
                        <StackPanel x:Name="BottomControls" VerticalAlignment="Bottom" Margin="24,0,24,14">
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="TimeText" Text="00:00" Foreground="White" VerticalAlignment="Center"
                                           FontFamily="Consolas" Margin="0,0,12,0" />
                                <Slider x:Name="SeekSlider" Grid.Column="1" Style="{StaticResource MediaSlider}" Minimum="0"
                                        Maximum="1" IsEnabled="False"
                                        PreviewMouseLeftButtonDown="SeekSlider_PreviewMouseDown"
                                        PreviewMouseLeftButtonUp="SeekSlider_PreviewMouseUp" />
                                <TextBlock x:Name="DurationText" Grid.Column="2" Text="--:--" Foreground="White"
                                           VerticalAlignment="Center" FontFamily="Consolas" Margin="12,0,0,0" />
                            </Grid>
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                                    <Button x:Name="PrevButton" Style="{StaticResource IconButton}" Content="&#xE892;"
                                            Foreground="White" ToolTip="Anterior" Click="Previous_Click" />
                                    <Button x:Name="PlayPauseButton" Style="{StaticResource IconButton}" Content="&#xE768;"
                                            Foreground="White" FontSize="22" Width="48" Height="48"
                                            ToolTip="Reproduzir/pausar (Espaço)" Click="PlayPause_Click" />
                                    <Button x:Name="NextButton" Style="{StaticResource IconButton}" Content="&#xE893;"
                                            Foreground="White" ToolTip="Próximo" Click="Next_Click" />
                                    <Button x:Name="BackTenButton" Style="{StaticResource IconButton}" Content="&#xEB9E;"
                                            Foreground="White" ToolTip="Voltar 10 s (←)" Click="BackTen_Click" />
                                    <Button x:Name="ForwardTenButton" Style="{StaticResource IconButton}" Content="&#xEB9D;"
                                            Foreground="White" ToolTip="Avançar 10 s (→)" Click="ForwardTen_Click" />
                                </StackPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <Button Style="{StaticResource IconButton}" Content="&#xE896;" Foreground="White"
                                            ToolTip="Baixar" Click="DownloadCurrent_Click" />
                                    <Button x:Name="MuteButton" Style="{StaticResource IconButton}" Content="&#xE767;"
                                            Foreground="White" ToolTip="Mudo (M)" Click="Mute_Click" />
                                    <Slider x:Name="VolumeSlider" Style="{StaticResource MediaSlider}" Width="100" Minimum="0"
                                            Maximum="100" VerticalAlignment="Center" ValueChanged="VolumeSlider_ValueChanged" />
                                    <Button Style="{StaticResource IconButton}" Content="&#xE740;" Foreground="White"
                                            ToolTip="Tela cheia (F / duplo clique)" Click="Fullscreen_Click" Margin="8,0,0,0" />
                                </StackPanel>
                                <TextBlock x:Name="LiveBadge" Text="● AO VIVO" Foreground="{StaticResource DangerBrush}"
                                           FontWeight="Bold" VerticalAlignment="Center" Margin="16,0" Visibility="Collapsed" />
                            </DockPanel>
                        </StackPanel>
                    </Grid>

                    <!-- Carregando / erro no centro -->
                    <StackPanel x:Name="CenterPanel" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                        <TextBlock x:Name="CenterIcon" FontFamily="{StaticResource IconFont}" FontSize="36" Foreground="White"
                                   HorizontalAlignment="Center" />
                        <TextBlock x:Name="CenterText" Foreground="White" FontSize="15" Margin="0,12,0,0"
                                   HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="480" />
                    </StackPanel>

                    <!-- "Continuando de 12:34" -->
                    <Border x:Name="ResumeToast" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="24,0,0,130"
                            Background="#E61A1826" CornerRadius="10" Padding="16,10" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="ResumeText" Foreground="White" VerticalAlignment="Center" />
                            <Button Content="Começar do início" Margin="16,0,0,0" Click="StartOver_Click" />
                        </StackPanel>
                    </Border>

                    <!-- "Pular abertura" (fica visível mesmo com os controles escondidos) -->
                    <Button x:Name="SkipIntroButton" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,32,140"
                            Click="SkipIntro_Click" Visibility="Collapsed" Cursor="Hand" ToolTip="Pular abertura (S)">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd" Background="#D9101015" BorderBrush="White" BorderThickness="1.5"
                                        CornerRadius="8" Padding="18,10">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xEB9D;" FontFamily="{StaticResource IconFont}" Foreground="White"
                                                   VerticalAlignment="Center" Margin="0,0,10,0" />
                                        <TextBlock Text="Pular abertura" Foreground="White" FontSize="15" FontWeight="SemiBold" />
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#33FFFFFF" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- Fim do episódio: contagem para o próximo -->
                    <Border x:Name="NextUpPanel" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,32,140"
                            Background="#F21A1826" CornerRadius="12" Padding="14" Width="420" Visibility="Collapsed">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid Height="80">
                                <Border CornerRadius="8" Background="{StaticResource Surface2Brush}" />
                                <Border x:Name="NextUpImage" CornerRadius="8" local:Art.Width="320" />
                            </Grid>
                            <StackPanel Grid.Column="1" Margin="14,0,0,0">
                                <TextBlock x:Name="NextUpCountdown" Foreground="{StaticResource MutedBrush}" FontSize="12" />
                                <TextBlock x:Name="NextUpTitle" Foreground="White" FontSize="15" FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                                <ProgressBar x:Name="NextUpProgress" Style="{StaticResource ThinProgress}" Maximum="5" Margin="0,8,0,10" />
                                <StackPanel Orientation="Horizontal">
                                    <Button Style="{StaticResource AccentButton}" Click="NextUpPlay_Click" Padding="12,6">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE768;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" />
                                            <TextBlock Text="Assistir agora" Margin="8,0,0,0" />
                                        </StackPanel>
                                    </Button>
                                    <Button Content="Cancelar" Click="NextUpCancel_Click" Margin="8,0,0,0" Padding="12,6" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Avisos rápidos dentro do player -->
                    <Border x:Name="PlayerToast" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,80,0,0"
                            Background="#E61A1826" CornerRadius="10" Padding="16,10" Visibility="Collapsed" IsHitTestVisible="False">
                        <TextBlock x:Name="PlayerToastText" Foreground="White" />
                    </Border>
                </Grid>
            </vlc:VideoView>
        </Grid>

        <!-- ═════════════ Prévia: card grande (≈ metade da janela) aberto ao clicar numa mídia ═════════════
             Clique no card → assiste. Clique fora (ou Esc) → volta para a lista. -->
        <Grid x:Name="PreviewLayer" Visibility="Collapsed" SizeChanged="PreviewLayer_SizeChanged">
            <Button Style="{StaticResource BareButton}" Background="#B3000000" Click="PreviewClose_Click"
                    AutomationProperties.Name="Voltar para a lista" />
            <Button x:Name="PreviewCardButton" Style="{StaticResource BareButton}" Click="PreviewCard_Click" Cursor="Hand"
                    HorizontalAlignment="Center" VerticalAlignment="Center" AutomationProperties.Name="Abrir mídia">
            <Border x:Name="PreviewCard" Width="640" CornerRadius="16" Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource LineBrush}" BorderThickness="1" RenderTransformOrigin="0.5,0.5">
                <Border.RenderTransform>
                    <ScaleTransform x:Name="PreviewScale" ScaleX="1" ScaleY="1" />
                </Border.RenderTransform>
                <Border.Effect>
                    <DropShadowEffect BlurRadius="40" ShadowDepth="0" Opacity="0.8" Color="Black" />
                </Border.Effect>
                <StackPanel>
                    <Grid x:Name="PreviewMediaArea" Height="360">
                        <Border CornerRadius="15,15,0,0" Background="{StaticResource Surface2Brush}" />
                        <TextBlock x:Name="PreviewInitials" FontSize="56" FontWeight="Bold" Opacity="0.4"
                                   Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <Border x:Name="PreviewArt" CornerRadius="15,15,0,0" />
                        <Border x:Name="PreviewVideoHost" CornerRadius="15,15,0,0" Opacity="0">
                            <Border.Background>
                                <ImageBrush x:Name="PreviewVideoBrush" Stretch="UniformToFill" />
                            </Border.Background>
                        </Border>
                        <Border VerticalAlignment="Bottom" Height="110" IsHitTestVisible="False">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#001A1826" Offset="0" />
                                    <GradientStop Color="#FF1A1826" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <TextBlock x:Name="PreviewLive" Text="● AO VIVO" Foreground="{StaticResource DangerBrush}" FontWeight="Bold"
                                   HorizontalAlignment="Left" VerticalAlignment="Top" Margin="18" Visibility="Collapsed" />
                        <Button x:Name="PreviewCloseButton" Style="{StaticResource IconButton}" Content="&#xE711;"
                                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="12" Width="38" Height="38"
                                Background="#80000000" ToolTip="Fechar (Esc)" Click="PreviewClose_Click" />
                        <Button x:Name="PreviewMuteButton" Style="{StaticResource IconButton}" Content="&#xE767;"
                                HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,16,8" Width="40" Height="40"
                                Background="#80000000" ToolTip="Som da prévia" Click="PreviewMute_Click" />
                        <TextBlock x:Name="PreviewTitle" FontSize="26" FontWeight="Bold" Margin="24,0,72,8" TextWrapping="Wrap"
                                   VerticalAlignment="Bottom" IsHitTestVisible="False" />
                    </Grid>
                    <StackPanel Margin="24,4,24,22">
                        <TextBlock x:Name="PreviewMeta" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
                        <ProgressBar x:Name="PreviewProgress" Style="{StaticResource ThinProgress}" Maximum="1" Margin="0,10,0,0"
                                     Visibility="Collapsed" />
                        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                            <Button x:Name="PreviewPlayButton" Style="{StaticResource AccentButton}" Click="PreviewPlay_Click" Padding="20,9">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE768;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" />
                                    <TextBlock x:Name="PreviewPlayText" Text="Assistir" Margin="8,0,0,0" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="PreviewEpisodesButton" Content="Ver episódios" Margin="10,0,0,0" Padding="16,9"
                                    Click="PreviewEpisodes_Click" />
                            <Button x:Name="PreviewDownloadButton" Style="{StaticResource IconButton}" Content="&#xE896;" Margin="10,0,0,0"
                                    Width="40" Height="40" Background="{StaticResource Surface2Brush}" ToolTip="Baixar" Click="PreviewDownload_Click" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>
            </Button>
        </Grid>

        <!-- ═════════════ Avisos rápidos ═════════════ -->
        <Border x:Name="Toast" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,28"
                Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                CornerRadius="10" Padding="18,12" Visibility="Collapsed" IsHitTestVisible="False">
            <TextBlock x:Name="ToastText" TextWrapping="Wrap" MaxWidth="560" />
        </Border>

        <!-- ═════════════ Painel "Listas" ═════════════ -->
        <Popup x:Name="ListsPopup" PlacementTarget="{Binding ElementName=ListsButton}" Placement="Bottom"
               HorizontalOffset="-380" VerticalOffset="8" StaysOpen="False" AllowsTransparency="True">
            <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                    CornerRadius="12" Padding="18" Width="480">
                <StackPanel>
                    <TextBlock Text="Lista M3U" FontSize="16" FontWeight="Bold" />
                    <TextBlock Text="Cole a URL ou escolha um arquivo. A lista fica salva e abre sozinha da próxima vez."
                               Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,12" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="SourceBox" Tag="https://... ou C:\listas\minha.m3u" KeyDown="SourceBox_KeyDown" />
                        <Button Grid.Column="1" Content="Carregar" Style="{StaticResource AccentButton}" Margin="8,0,0,0"
                                Click="LoadButton_Click" />
                    </Grid>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="Abrir arquivo..." Click="BrowseButton_Click" />
                        <Button x:Name="RefreshButton" Content="Atualizar lista agora" Click="RefreshButton_Click" Margin="8,0,0,0" />
                    </StackPanel>
                    <TextBlock x:Name="ListStatusText" Foreground="{StaticResource MutedBrush}" Margin="0,10,0,0" TextWrapping="Wrap" />

                    <TextBlock Text="Listas salvas" FontWeight="SemiBold" Margin="0,18,0,6" />
                    <ItemsControl x:Name="SavedSourcesList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Button Click="SavedSource_Click" HorizontalContentAlignment="Left" ToolTip="{Binding Source}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE73E;" FontFamily="{StaticResource IconFont}"
                                                       Foreground="{StaticResource AccentBrush}" Margin="0,0,8,0" VerticalAlignment="Center"
                                                       Visibility="{Binding IsActive, Converter={StaticResource BoolToVis}}" />
                                            <TextBlock Text="{Binding Display}" TextTrimming="CharacterEllipsis" MaxWidth="370" />
                                        </StackPanel>
                                    </Button>
                                    <Button Grid.Column="1" Style="{StaticResource IconButton}" Content="&#xE711;" FontSize="11"
                                            Width="32" Height="32" Margin="4,0,0,0" ToolTip="Remover" Click="ForgetSource_Click" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border Height="1" Background="{StaticResource LineBrush}" Margin="0,14" />
                    <TextBlock Text="Pasta dos filmes e canais" FontWeight="SemiBold" />
                    <DockPanel Margin="0,6,0,0">
                        <Button DockPanel.Dock="Right" Content="Alterar..." Tag="movies" Click="ChooseFolder_Click" Margin="8,0,0,0" />
                        <TextBlock x:Name="FolderText" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" />
                    </DockPanel>
                    <TextBlock Text="Pasta das séries" FontWeight="SemiBold" Margin="0,12,0,0" />
                    <DockPanel Margin="0,6,0,0">
                        <Button DockPanel.Dock="Right" Content="Alterar..." Tag="series" Click="ChooseFolder_Click" Margin="8,0,0,0" />
                        <TextBlock x:Name="SeriesFolderText" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" />
                    </DockPanel>
                </StackPanel>
            </Border>
        </Popup>

        <!-- ═════════════ Prévia ao parar o mouse 4 s sobre um card (estilo Netflix) ═════════════ -->
    </Grid>
</Window>
