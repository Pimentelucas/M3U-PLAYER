<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>M3UPlayer</AssemblyName>
    <RootNamespace>M3UPlayer</RootNamespace>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <!-- Copia apenas as DLLs x64 do libVLC -->
    <VlcWindowsX86Enabled>false</VlcWindowsX86Enabled>
    <!-- Listas enormes (centenas de milhares de itens) criam milhões de objetos ao abrir: o GC de servidor
         trabalha em paralelo (organizar a lista cai de ~1,3 s para ~0,5 s) e o DATAS mantém a memória baixa. -->
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <GarbageCollectionAdaptationMode>1</GarbageCollectionAdaptationMode>
    <!-- Código pré-compilado no publish: o app abre mais rápido (menos compilação JIT na partida) -->
    <PublishReadyToRun>true</PublishReadyToRun>
    <Version>1.0.0</Version>
    <Product>M3U Player</Product>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="LibVLCSharp.WPF" Version="3.10.2" />
    <PackageReference Include="VideoLAN.LibVLC.Windows" Version="3.0.24" />
  </ItemGroup>

</Project>
